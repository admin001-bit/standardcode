{
  "name": "standardcode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "bench:cold-start": "node apps/cli/scripts/cold-start.mjs",
    "golden:capture": "node evals/golden/capture.mjs",
    "golden:capture:compact": "node evals/golden/capture-compact.mjs",
    "golden:capture:antifab": "node evals/golden/capture-antifab.mjs > evals/golden/baselines/anti-fabrication.json",
    "golden:compare": "node evals/golden/compare.mjs",
    "evals:run": "vitest run evals/benchmark/benchmark.test.ts",
    "evals:live": "vitest run evals/benchmark/live.test.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/providers && tsc -p packages/harness && tsc -p packages/context && tsc -p packages/platform && tsc -p packages/executor && tsc -p packages/capabilities && tsc -p apps/cli && tsc -p evals",
    "rust:fmt": "cargo fmt --all --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace"
  },
  "devDependencies": {
    "@standardcode-oss/cli": "workspace:*",
    "@types/node": "^24.3.0",
    "bun": "1.4.2",
    "esbuild": "0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
